import cv2
import numpy as np

cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()
    if not ret:
        break

    height, width = frame.shape[:2]
    resized = cv2.resize(frame, (int(width / 2), int(height / 2)),
                          interpolation=cv2.INTER_AREA)

    cv2.imshow("WebCam", resized)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
